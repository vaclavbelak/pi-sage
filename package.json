{
  "name": "pi-sage",
  "version": "0.1.0",
  "description": "Sage (Safety for Agents) connector for the pi coding agent",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "sage",
    "security",
    "adr",
    "agent-security"
  ],
  "files": [
    "extensions",
    "src",
    "bin",
    "resources",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./extensions/sage.ts"
    ]
  },
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "prepack": "node scripts/sync-assets.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PI_SAGE_E2E=1 vitest run src/__tests__/e2e.test.ts"
  },
  "dependencies": {
    "@gendigital/sage-core": "^0.13.0",
    "@gendigital/sage-mcp": "^0.13.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:vaclavbelak/pi-sage.git"
  },
  "homepage": "https://ai.gendigital.com/sage",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
